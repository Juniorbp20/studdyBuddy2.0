<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorSurfaceVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingEnd="12dp">

        <!-- Category color bar on left -->
        <View
            android:id="@+id/view_upcoming_category_indicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_category_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <CheckBox
            android:id="@+id/checkbox_upcoming_completed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:buttonTint="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view_upcoming_category_indicator"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_upcoming_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/image_upcoming_priority"
            app:layout_constraintStart_toEndOf="@+id/checkbox_upcoming_completed"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Repasar apuntes de Álgebra" />

        <!-- Metadata Row: Category Pill, Due Date, Time, Overdue -->
        <LinearLayout
            android:id="@+id/layout_upcoming_metadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/checkbox_upcoming_completed"
            app:layout_constraintTop_toBottomOf="@+id/text_upcoming_title">

            <!-- Category Pill -->
            <LinearLayout
                android:id="@+id/layout_upcoming_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <ImageView
                    android:id="@+id/image_upcoming_category"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cat_star" />

                <TextView
                    android:id="@+id/text_upcoming_category_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Estudio" />
            </LinearLayout>

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_event"
                app:tint="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/text_upcoming_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                tools:text="Hoy, 16:00" />

            <TextView
                android:id="@+id/text_upcoming_overdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_overdue_badge"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="@string/task_overdue_badge"
                android:textColor="#DC2626"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageView
            android:id="@+id/image_upcoming_priority"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Prioridad"
            android:src="@drawable/ic_priority"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
